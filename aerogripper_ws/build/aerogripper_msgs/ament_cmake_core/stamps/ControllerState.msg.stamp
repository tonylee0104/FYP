# 控制器状态消息
# 用于发布控制器的内部状态数据，便于调试和监控

# 时间戳
builtin_interfaces/Time timestamp

# 时间步长 (dt)
float64 dt

# 期望加速度 (a_des)
geometry_msgs/Vector3 desired_acceleration

# 期望角速度 (omega_des)
geometry_msgs/Vector3 desired_angular_velocity

# 期望推力 (T_des)
geometry_msgs/Vector3 desired_thrust

# 期望力矩 (tau_des)
geometry_msgs/Vector3 desired_torque

# 当前位置
geometry_msgs/Point current_position

# 当前速度
geometry_msgs/Vector3 current_velocity

# 当前姿态四元数
geometry_msgs/Quaternion current_orientation

# 当前姿态欧拉角 (roll, pitch, yaw) [弧度]
geometry_msgs/Vector3 current_euler_angles

# 当前角速度
geometry_msgs/Vector3 current_angular_velocity

# 参考位置
geometry_msgs/Point reference_position

# 参考速度
geometry_msgs/Vector3 reference_velocity

# 参考姿态四元数
geometry_msgs/Quaternion reference_orientation

# 参考姿态欧拉角 (roll, pitch, yaw) [弧度]
geometry_msgs/Vector3 reference_euler_angles

# 油门输出值
float64[4] throttle_output

# 绳子拉力观测值 (在机体坐标系下)
geometry_msgs/Vector3 tether_force_bodyframe
